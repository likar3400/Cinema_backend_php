    <link rel="stylesheet" href="http://localhost:8888/course_work_CINEMA/course_work/public/css/style.css">
    <meta name="csrf" content="7a9326d7bedf932b003efb76cf660eb5b4760cdd9188b3952a08c4d307c0d412">
</head>
<body>

<nav class="navbar">
    <div class="container nav-inner">
        <a href="http://localhost:8888/course_work_CINEMA/course_work/public/" class="brand">🎬 CineMax</a>
        <ul class="nav-links" id="navLinks">
            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/"         >Головна</a></li>
            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/movies"   >Афіша</a></li>
            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/schedule" class="active">Розклад</a></li>
            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/news"     >Новини</a></li>
            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/shop"     >🍿 Магазин</a></li>
                            <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/login">Вхід</a></li>
                <li><a href="http://localhost:8888/course_work_CINEMA/course_work/public/register" class="nav-register">Реєстрація</a></li>
                    </ul>
        <button class="burger" id="burger" aria-label="Меню">☰</button>
    </div>
</nav>


<main class="main">
    <div class="container">
        <!-- БАНЕР — повна ширина -->
<style>
.schedule-banner-full {
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  height: 260px;
  overflow: hidden;
  margin-bottom: 2rem;
}
.schedule-banner-full iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
  pointer-events: none;
}
.schedule-banner-full .banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(20,20,40,.75) 0%, rgba(20,20,40,.4) 100%);
  display: flex;
  align-items: center;
  padding: 0 5vw;
}
.schedule-banner-full .banner-overlay h1 {
  color: #fff;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  margin: 0 0 .4rem;
}
.schedule-banner-full .banner-overlay p {
  color: rgba(255,255,255,.82);
  font-size: 1.1rem;
  margin: 0;
}
</style>

<div class="schedule-banner-full">
  <iframe src="http://localhost:8888/course_work_CINEMA/course_work/public/images/cinemax_cinema_banner.html" scrolling="no" frameborder="0" title="CineMax"></iframe>
  <div class="banner-overlay">
    <div>
      <h1>Розклад сеансів</h1>
      <p>Літо 2026 — кращі фільми кожного дня</p>
    </div>
  </div>
</div>

<div class="filter-bar card">
  <div class="fg"><label>Дата</label>
    <input type="date" id="fDate" value="2026-05-27" min="2026-05-27"></div>
  <div class="fg"><label>Фільм</label>
    <select id="fMovie">
      <option value="0">Всі фільми</option>
            <option value="7" >Мандалорець</option>
            <option value="5" >Гладіатор 2</option>
            <option value="6" >Майкл</option>
            <option value="2" >Оппенгеймер</option>
            <option value="8" >Kermit and friend</option>
            <option value="1" >Дюна: Частина Друга</option>
          </select></div>
  <button class="btn btn-primary" onclick="loadSched()">🔍 Знайти</button>
</div>

<div id="schedResult">
  <p class="empty-msg">Сеансів не знайдено. Оберіть іншу дату.</p>
</div>

<script>
const IS_AUTH = false;
var APP_URL_JS = 'http://localhost:8888/course_work_CINEMA/course_work/public';

function loadSched() {
  const date  = document.getElementById('fDate').value;
  const movie = document.getElementById('fMovie').value;
  const res   = document.getElementById('schedResult');
  res.innerHTML = '<p class="loading">⏳ Завантаження…</p>';
  fetch(`${APP_URL_JS}/api/sessions?date=${date}&movie_id=${movie}`,
    {headers:{'X-Requested-With':'XMLHttpRequest'}})
  .then(r=>r.json()).then(d=>{
    if (!d.sessions || !d.sessions.length) {
      res.innerHTML='<p class="empty-msg">Сеансів не знайдено. Оберіть іншу дату.</p>'; return;
    }
    const grouped={};
    d.sessions.forEach(s=>{
      const day=new Date(s.starts_at.replace(' ','T')).toLocaleDateString('uk-UA');
      if (!grouped[day]) grouped[day]=[];
      grouped[day].push(s);
    });
    let html='';
    for (const [day,items] of Object.entries(grouped)) {
      html+=`<div class="day-group"><h3 class="day-label">📅 ${day}</h3><div class="sessions-grid">`;
      items.forEach(s=>{
        const t=new Date(s.starts_at.replace(' ','T')).toLocaleTimeString('uk-UA',{hour:'2-digit',minute:'2-digit'});
        const vip=s.price_vip>0?`<span class="price-vip">VIP: ${parseInt(s.price_vip)} грн</span>`:'';
        const poster=s.poster?`<img src="${APP_URL_JS}${s.poster}" alt="${s.movie_title}" class="sess-poster-sm">`:'';
        const btn=IS_AUTH
          ?`<a href="${APP_URL_JS}/booking/${s.id}" class="btn btn-primary btn-sm">Купити</a>`
          :`<a href="${APP_URL_JS}/login" class="btn btn-outline btn-sm">Увійти</a>`;
        html+=`<div class="sess-card">
          ${poster}
          <div class="sess-movie">${s.movie_title}</div>
          <div class="sess-time">${t}</div>
          <div class="sess-meta">${s.hall_name} · ${s.format}</div>
          <div class="sess-price"><span class="price-std">Стд: ${parseInt(s.price)} грн</span>${vip}</div>
          ${btn}</div>`;
      });
      html+='</div></div>';
    }
    res.innerHTML=html;
  }).catch(()=>{res.innerHTML='<p class="empty-msg">Помилка завантаження.</p>';});
}
document.getElementById('fDate').addEventListener('change',loadSched);
document.getElementById('fMovie').addEventListener('change',loadSched);
</script>
    </div>
</main>

<footer class="footer">
    <div class="container footer-inner">
        <div class="footer-brand">🎬 CineMax</div>
        <div class="footer-links">
            <a href="http://localhost:8888/course_work_CINEMA/course_work/public/movies">Афіша</a>
            <a href="http://localhost:8888/course_work_CINEMA/course_work/public/schedule">Розклад</a>
            <a href="http://localhost:8888/course_work_CINEMA/course_work/public/shop">Магазин</a>
            <a href="http://localhost:8888/course_work_CINEMA/course_work/public/news">Новини</a>
        </div>
        <div class="footer-copy">© 2026 CineMax. Всі права захищено.</div>
    </div>
</footer>
<script>
    const CSRF_TOKEN = '7a9326d7bedf932b003efb76cf660eb5b4760cdd9188b3952a08c4d307c0d412';
    const APP_URL    = 'http://localhost:8888/course_work_CINEMA/course_work/public';
</script>
<script src="http://localhost:8888/course_work_CINEMA/course_work/public/js/app.js"></script>
</body>
</html>